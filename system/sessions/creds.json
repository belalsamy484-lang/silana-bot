// هذا الكود يوضع داخل دالة استقبال الرسائل في (handler.js)

async function handleIncomingMessage(msg, sock) {
    const jid = msg.key.remoteJid;
    
    // 1. تحديد نوع الرسالة الجاية من الواتساب
    const messageType = Object.keys(msg.message)[0]; 
    
    // 2. استخراج النص أو الـ ID بناءً على نوع الرسالة
    let userText = '';
    let selectedId = '';

    if (messageType === 'conversation' || messageType === 'extendedTextMessage') {
        userText = msg.message.conversation || msg.message.extendedTextMessage.text;
    } else if (messageType === 'buttonsResponseMessage') {
        selectedId = msg.message.buttonsResponseMessage.selectedButtonId;
    } else if (messageType === 'listResponseMessage') {
        selectedId = msg.message.listResponseMessage.singleSelectReply.selectedRowId;
    }

    // 3. توجيه الردود بناءً على المدخلات (الكود المجمع)
    
    // أ. لو المستخدم كتب كلمة معينة (مثلاً: "خدمات") نبعتله القائمة
    if (userText === 'خدمات') {
        const sections = [
            {
                title: "خدمات Decor Plus",
                rows: [
                    { title: "أرضيات هارنجبون طبيعي", rowId: "natural_herringbone", description: "أفخم أنواع الأخشاب الطبيعية" },
                    { title: "تجليد حوائط", rowId: "wood_cladding", description: "حلول خشبية عصرية" }
                ]
            }
        ];
        const listMessage = {
            text: "مرحباً بك في ديكور بلس، اختر الخدمة:",
            buttonText: "عرض الخدمات",
            sections
        };
        await sock.sendMessage(jid, listMessage);
        return; // بنوقف الكود هنا عشان ميكملش
    }

    // ب. معالجة اختيارات الأزرار والقوائم في مكان واحد
    if (selectedId) {
        switch (selectedId) {
            case 'natural_herringbone':
                await sock.sendMessage(jid, { text: "اختيار ممتاز! نحن نعتمد على الهارنجبون الطبيعي بالكامل لضمان أعلى جودة وعمر افتراضي طويل. هل ترغب في تحديد موعد للمعاينة؟" });
                break;
                
            case 'wood_cladding':
                await sock.sendMessage(jid, { text: "تجليد الحوائط لدينا يضيف لمسة فخامة فريدة. جاري تحويلك للمهندس المختص للتفاصيل..." });
                break;
                
            case 'customer_service': // لو كان ده ID لزرار خدمة العملاء
                await sock.sendMessage(jid, { text: "سيتم تحويلك الآن إلى أحد ممثلي خدمة العملاء. يرجى الانتظار..." });
                break;

            default:
                await sock.sendMessage(jid, { text: "عفواً، لم أتمكن من فهم طلبك." });
                break;
        }
    }
}
